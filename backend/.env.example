MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/crypto-advisor?retryWrites=true&w=majority
PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying
FRONTEND_URL=http://localhost:5173
NVIDIA_API_KEY=
# Optional. Defaults to meta/llama-3.1-8b-instruct if unset. Override here
# (no code change/redeploy needed) if a model is ever pulled from NVIDIA's
# catalog — same reasoning as the earlier OpenRouter model getting delisted.
NVIDIA_MODEL=
