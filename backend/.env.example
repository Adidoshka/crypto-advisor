MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/crypto-advisor?retryWrites=true&w=majority
PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying
FRONTEND_URL=http://localhost:5173
OPENROUTER_API_KEY=
# Optional. Defaults to mistralai/mistral-7b-instruct:free if unset. Override
# here (no code change/redeploy needed) if OpenRouter delists the default —
# free-tier models rotate.
OPENROUTER_MODEL=
